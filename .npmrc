# @gatehub/toolbox is published to the public npm registry but is private —
# CI/local installs need an auth token exported as NPM_TOKEN.
# //registry.npmjs.org/:_authToken=${NPM_TOKEN}

# pnpm: hoist nest/clickhouse peer deps so apps resolve them from the workspace root.
shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true
