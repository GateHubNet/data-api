    "sjcl": "^1.0.8",
    "xrpl": "^2.14.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.12",
    "@types/sjcl": "^1.0.34",
    "jest": "^29.7.0",
    "testcontainers": "^10.13.0",
    "ts-jest": "^29.2.3",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
