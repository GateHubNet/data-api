{
  "name": "@gatehub/data-api-service",
  "version": "0.0.1",
  "description": "GateHub XRPL Data API — REST service serving ledger data from ClickHouse.",
  "private": true,
  "license": "UNLICENSED",
  "author": "GateHub",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "NODE_ENV=test jest --config ./jest-config.json --runInBand --passWithNoTests",
    "test:e2e": "NODE_ENV=test jest --config ./test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@clickhouse/client": "^1.4.0",
    "@gatehub/data-api-shared": "workspace:*",
    "@gatehub/toolbox": "^0.2.6",
    "@nestjs/common": "^10.3.10",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^10.3.10",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/throttler": "^5.2.0",
    "bignumber.js": "^9.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "nice-json2csv": "^0.2.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.0",
    "ripple-address-codec": "^4.3.1",
    "ripple-binary-codec": "^2.11.0",
    "rxjs": "^7.8.1",
    "xrpl": "^2.14.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.2",
    "@nestjs/schematics": "^10.1.3",
    "@nestjs/testing": "^10.3.10",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.12",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "testcontainers": "^10.13.0",
    "ts-jest": "^29.2.3",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.2"
  }
}
