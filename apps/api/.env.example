GH_SERVICE_NAME=data-api
GH_SERVICE_VERSION=0.0.1
GH_SERVICE_DESCRIPTION="GateHub XRPL Data API"

GH_LOGGER_FORMAT=pretty
GH_LOGGER_LEVEL=debug

# HTTP port for the REST API + swagger docs (/internal/docs). Metrics on /metricz.
GH_HTTP_API_PORT=3001

# Comma-separated allowed CORS origins (empty = disabled).
GH_CORS_ORIGINS=

# Comma-separated API keys. Clients send one as `X-API-Key:` or `Authorization: Bearer`.
# Empty = authentication disabled (dev only; logs a warning in production).
# In production inject this from a secrets manager, never commit real keys.
GH_API_KEYS=

# TTL (ms) for cached live-XRPL responses (account balances / open orders). 0 disables.
GH_LIVE_CACHE_TTL_MS=10000

# Per-client rate limit (requests / window-seconds). The client is identified by the
# X-Forwarded-For IP set by the GateHub reverse proxy (see GH_TRUST_PROXY_HOPS).
GH_RATE_LIMIT=600
GH_RATE_LIMIT_WINDOW=60

# Reverse-proxy hops to trust for X-Forwarded-For. The service always runs behind the
# GateHub reverse proxy (which terminates TLS); 1 = trust that single hop.
GH_TRUST_PROXY_HOPS=1

# XRPL node, used for live account state (balances, open orders).
GH_XRPL_NODE_ENDPOINT=wss://xrplcluster.com

# --- ClickHouse --------------------------------------------------------------
GH_CLICKHOUSE_URL=http://localhost:8123
GH_CLICKHOUSE_USER=default
GH_CLICKHOUSE_PASSWORD=
GH_CLICKHOUSE_DATABASE=xrpl
GH_CLICKHOUSE_REQUEST_TIMEOUT=30000
GH_CLICKHOUSE_MAX_CONNECTIONS=10
# Per-query safety caps (defense-in-depth). 0 = unlimited / server default.
GH_CLICKHOUSE_MAX_EXECUTION_TIME=30
GH_CLICKHOUSE_MAX_QUERY_MEMORY=0
