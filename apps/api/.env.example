GH_SERVICE_NAME=data-api
GH_SERVICE_VERSION=0.0.1
GH_SERVICE_DESCRIPTION="Ripple Data API v2 compatible API for XRPL and Xahau"

GH_LOGGER_FORMAT=pretty
GH_LOGGER_LEVEL=debug

# --- Configuration loading ---------------------------------------------------
# The toolbox config loader reads `.env` (or `.env.$NODE_ENV` when NODE_ENV is set) from the working directory and
# refuses to start when that file is missing. Where the variables come from the environment (containers run with
# NODE_ENV=production), set GH_ENV to any value to skip the file:
# GH_ENV=container

# --- Network -----------------------------------------------------------------
# One API per network. Selects the native currency (XRP / XAH), the CTID network id (0 / 21337), the markets config and
# the default ClickHouse database (GH_CLICKHOUSE_DATABASE below overrides it).
GH_NETWORK=xrpl

# Comma separated rippled / xahaud websocket URLs for the live-state endpoints (balances, open orders), tried in order.
# Default when unset or empty: the public endpoint of GH_NETWORK (xrpl: wss://xrplcluster.com, xahau: wss://xahau.network).
#   xrpl:  wss://xrplcluster.com, wss://s2.ripple.com, or ws://your-own-rippled:6006
#   xahau: wss://xahau.network
# GH_NODE_ENDPOINTS=wss://xrplcluster.com

# --- HTTP --------------------------------------------------------------------
# REST API (/v2/*), liveliness probe (/liveliness/healthz) and swagger docs (/internal/docs).
GH_HTTP_API_PORT=3001
# Prometheus metrics: GET /metricz on a second port.
GH_METRICZ_PORT=3000

# Comma separated API keys. Clients send one as `X-API-Key:` or `Authorization: Bearer`; /v2/* needs it.
# Empty = authentication disabled (development only): with NODE_ENV=production the API refuses to start.
# In production inject this from a secrets manager, never commit real keys.
GH_API_KEYS=

# `*`, or comma separated allowed CORS origins (http:// or https://). Empty = no CORS headers.
GH_CORS_ORIGINS=

# `Cache-Control` of successful /v2/* responses (errors are always `no-store`). Empty = none.
GH_CACHE_CONTROL="public, max-age=60"

# Per-client rate limit of /v2/* (requests / window-seconds, counted per client address and route). The client is
# identified by the X-Forwarded-For IP set by the GateHub reverse proxy (see GH_TRUST_PROXY_HOPS).
GH_RATE_LIMIT=600
GH_RATE_LIMIT_WINDOW=60

# Reverse-proxy hops to trust for X-Forwarded-For. The service always runs behind the GateHub reverse proxy (which
# terminates TLS); 1 = trust that single hop.
GH_TRUST_PROXY_HOPS=1

# TTL (ms) for cached live-node responses (account balances / open orders). 0 disables.
GH_LIVE_CACHE_TTL_MS=10000

# --- ClickHouse --------------------------------------------------------------
GH_CLICKHOUSE_URL=http://localhost:8123
GH_CLICKHOUSE_USER=default
GH_CLICKHOUSE_PASSWORD=
# Default: the network name (xrpl / xahau).
# GH_CLICKHOUSE_DATABASE=xrpl
GH_CLICKHOUSE_REQUEST_TIMEOUT=30000
GH_CLICKHOUSE_MAX_CONNECTIONS=10
# Per-query safety caps (defense-in-depth). 0 = unlimited / server default.
GH_CLICKHOUSE_MAX_EXECUTION_TIME=30
GH_CLICKHOUSE_MAX_QUERY_MEMORY=0
