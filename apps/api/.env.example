# Copy to apps/api/.env to run the API from source (`pnpm start:api`). In the docker stacks the same variables come from
# the compose files (docker-compose.yaml, docker-compose.prod.yaml + deploy/.env.prod.example).

# --- Configuration loading ---------------------------------------------------
# The toolbox config loader reads `.env` (or `.env.$NODE_ENV` when NODE_ENV is set) from the working directory and
# refuses to start when that file is missing. Where the variables come from the environment (containers run with
# NODE_ENV=production), set GH_ENV to any value to skip the file:
# GH_ENV=container

# --- Network -----------------------------------------------------------------
# One API per network. Selects the native currency (XRP / XAH), the CTID network id (0 / 21337), the markets config and
# the default ClickHouse database (GH_CLICKHOUSE_DATABASE below overrides it).
GH_NETWORK=xrpl

# Comma separated rippled / xahaud websocket URLs for the live-state endpoints (balances, open orders), tried in order.
# Default when unset or empty: the public endpoints of GH_NETWORK (xrpl: wss://s2.ripple.com,wss://xrplcluster.com, xahau: wss://xahau.network).
#   xrpl:  wss://s2.ripple.com, wss://xrplcluster.com, or ws://your-own-rippled:6006
#   xahau: wss://xahau.network
# GH_NODE_ENDPOINTS=wss://s2.ripple.com,wss://xrplcluster.com

# --- HTTP --------------------------------------------------------------------
# REST API (/v2/*), liveliness probe (/liveliness/healthz) and swagger docs (/internal/docs).
GH_HTTP_API_PORT=3001
# Prometheus metrics: GET /metricz on a second port.
GH_METRICZ_PORT=3000

# Comma separated API keys. Clients send one as `X-API-Key:` or `Authorization: Bearer`; /v2/* needs it.
# Empty = authentication disabled (development only): with NODE_ENV=production the API refuses to start.
# In production inject this from a secrets manager, never commit real keys.
GH_API_KEYS=

# `*`, or comma separated allowed CORS origins (http:// or https://). Empty = no CORS headers.
GH_CORS_ORIGINS=

# `Cache-Control` of successful /v2/* responses (errors are always `no-store`). Empty = none. `private` because the answers
# are key-gated: a shared cache that ignores the API key would serve them to anybody (`public` only behind a CDN that keys on it).
GH_CACHE_CONTROL="private, max-age=60"

# File of the amendment metadata (names, descriptions, specifications) behind /v2/network/amendments. Optional: the default is the
# config/amendments/<network>.json that ships with the shared package. The syncer reads the same variable and should be given
# the same file.
# GH_AMENDMENTS_CONFIG=/path/to/amendments.json

# How often (ms) the account names of the shared database (GH_CLICKHOUSE_SHARED_DATABASE below) are loaded again: a row the
# operator inserts shows on /v2/accounts/{address} within this time.
GH_NAMES_AND_LABELS_RELOAD_MS=60000

# Per-client rate limit of /v2/* (requests / window-seconds, counted per client address and route). The client is
# identified by the X-Forwarded-For IP set by the GateHub reverse proxy (see GH_TRUST_PROXY_HOPS).
GH_RATE_LIMIT=600
GH_RATE_LIMIT_WINDOW=60
# Comma separated `key=limit` pairs: a request made with a listed key is counted per key and route, with that limit per window,
# instead of per client address (for a trusted server-side client whose requests share addresses). Every key must also be in
# GH_API_KEYS, or the boot fails. A secret. Empty = every client is limited by address.
GH_RATE_LIMIT_KEYS=

# Reverse-proxy hops to trust for X-Forwarded-For. The service always runs behind the GateHub reverse proxy (which
# terminates TLS); 1 = trust that single hop.
GH_TRUST_PROXY_HOPS=1

# TTL (ms) for cached live-node responses (account balances / open orders). 0 disables.
GH_LIVE_CACHE_TTL_MS=10000

# Serialized transactions kept in memory by hash (decoded JSON + binary hex), to spare the codec on repeated requests.
# A transaction never changes, so nothing expires; each entry is a few KB. 0 disables.
GH_TX_CACHE_SIZE=20000

# Title of the swagger document at /internal/docs (read by the toolbox). Optional: the defaults are the values below,
# GH_SERVICE_VERSION defaults to the version of apps/api/package.json.
# GH_SERVICE_NAME=data-api
# GH_SERVICE_DESCRIPTION="Ripple Data API v2 compatible API for XRPL and Xahau, served from ClickHouse."
# GH_SERVICE_VERSION=0.0.1

# --- ClickHouse --------------------------------------------------------------
GH_CLICKHOUSE_URL=http://localhost:8123
GH_CLICKHOUSE_USER=default
GH_CLICKHOUSE_PASSWORD=
# Default: the network name (xrpl / xahau).
# GH_CLICKHOUSE_DATABASE=xrpl
# The shared database on the same server (account names, ADR-0014), which the apis of every network read. Created and
# migrated by `pnpm ch:migrate:shared`. Default: shared.
# GH_CLICKHOUSE_SHARED_DATABASE=shared
GH_CLICKHOUSE_REQUEST_TIMEOUT=30000
GH_CLICKHOUSE_MAX_CONNECTIONS=10
# Per-query safety caps (defense-in-depth). 0 = unlimited / server default.
GH_CLICKHOUSE_MAX_EXECUTION_TIME=30
GH_CLICKHOUSE_MAX_QUERY_MEMORY=0
