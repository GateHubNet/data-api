{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "roots": ["./src"],
  "testEnvironment": "node",
  "testRegex": "^(?!.*e2e-).*\\.spec\\.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "setupFiles": ["<rootDir>/test/jest-setup.js"],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "testTimeout": 30000,
  "collectCoverageFrom": ["src/**/*.ts"],
  "coverageDirectory": "../coverage"
}
