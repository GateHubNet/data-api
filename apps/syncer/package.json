{
  "name": "@gatehub/data-syncer",
  "version": "0.0.1",
  "description": "GateHub XRPL syncer — ingests ledgers from the XRP Ledger, parses them and writes to ClickHouse.",
  "private": true,
  "license": "UNLICENSED",
  "author": "GateHub",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "ingest:range": "node dist/cli/range-ingest.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "NODE_ENV=test jest --config ./jest-config.json --runInBand --passWithNoTests",
    "test:e2e": "NODE_ENV=test jest --config ./test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@clickhouse/client": "^1.4.0",
    "@gatehub/data-api-shared": "workspace:*",
    "@gatehub/toolbox": "^0.2.6",
    "@nestjs/common": "^10.3.10",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^10.3.10",
    "@nestjs/terminus": "^10.2.3",
    "bignumber.js": "^9.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.4.5",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "xrpl": "^2.14.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.2",
    "@nestjs/schematics": "^10.1.3",
    "@nestjs/testing": "^10.3.10",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.12",
    "@types/ws": "^8.18.2",
    "jest": "^29.7.0",
    "testcontainers": "^10.13.0",
    "ts-jest": "^29.2.3",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.2",
    "ws": "^8.21.0"
  }
}
