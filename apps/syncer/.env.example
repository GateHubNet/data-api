# Copy to apps/syncer/.env to run the syncer from source (`pnpm start:syncer`). In the docker stacks the same variables
# come from the compose files (docker-compose.yaml, docker-compose.prod.yaml + deploy/.env.prod.example).

# --- Configuration loading ---------------------------------------------------
# The toolbox config loader reads `.env` (or `.env.$NODE_ENV` when NODE_ENV is set) from the working directory and
# refuses to start when that file is missing. Where the variables come from the environment (containers run with
# NODE_ENV=production), set GH_ENV to any value to skip the file:
# GH_ENV=container

# --- Network -----------------------------------------------------------------
# One syncer per network: xrpl, xahau, xrpl-testnet or xahau-testnet. Selects the native currency (XRP / XAH), the CTID
# network id (0 / 21337 / 1 / 21338), the markets config and the default ClickHouse database (GH_CLICKHOUSE_DATABASE below
# overrides it). Boot fails when the node's network_id does not match.
GH_NETWORK=xrpl

# Comma separated rippled / xahaud websocket URLs, tried in order with failover.
# Default when unset or empty: the public endpoints of GH_NETWORK (xrpl: wss://s2.ripple.com,wss://xrplcluster.com, xahau: wss://xahau.network,
# xrpl-testnet: wss://s.altnet.rippletest.net:51233,wss://testnet.xrpl-labs.com, xahau-testnet: wss://xahau-test.net).
# A node that answers "rate limit ... retry in ~<N>ms" (or slowDown / tooBusy) is left alone for that long, and the next
# endpoint of the list is used meanwhile.
# A full-history syncer should point at its own node, or at Ripple's full history server:
#   xrpl:  wss://s2.ripple.com (Ripple full history), wss://xrplcluster.com, or ws://your-own-rippled:6006
#   xahau: wss://xahau.network
#   xrpl-testnet / xahau-testnet: the public servers above, or your own node of that testnet
GH_NODE_ENDPOINTS=wss://s2.ripple.com

# Nodes the validations collector subscribes to (one connection each). Default: GH_NODE_ENDPOINTS.
# GH_VALIDATION_ENDPOINTS=wss://s1.ripple.com,wss://s2.ripple.com

# --- Workers -----------------------------------------------------------------
# Comma separated subset of ingest,validations,fee_stats,aggregator,validators. An empty value runs none of them (the
# process then only serves the probe and the metrics). Run exactly one syncer per network and database.
GH_WORKERS=ingest,validations,fee_stats,aggregator,validators

# --- Ingest ------------------------------------------------------------------
# First ledger of a database that has none yet. Default: the validated head at boot. Ignored once ledgers exist
# (the syncer continues after the committed checkpoint).
# GH_SYNC_START_LEDGER=

# Timeout of one expanded `ledger` request, in ms.
GH_LEDGER_FETCH_TIMEOUT_MS=120000

# Catch-up: ledgers fetched in parallel, and when a batch is written to ClickHouse - at this many ledgers, this many
# transactions or this many ms, whichever comes first. Observed on the public nodes: wss://s2.ripple.com did not throttle
# a first sync at 2; wss://xahau.network throttles even at 1, which the syncer waits out (slower, not failing). Raise it
# with your own node.
GH_CATCHUP_CONCURRENCY=4
GH_CATCHUP_FLUSH_LEDGERS=300
GH_CATCHUP_FLUSH_TXS=100000
GH_CATCHUP_FLUSH_MS=5000

# Apply the ClickHouse schema before the workers start (all DDL is idempotent, applied files are checksummed).
# Leave false where a one-shot migrate job owns the schema (the compose files: migrate-xrpl / migrate-xahau). Running from
# source, either set true or run `pnpm ch:migrate` (with GH_NETWORK set) once.
GH_RUN_MIGRATIONS_ON_BOOT=false

# Directory of the *.sql migrations and file of the aggregator's markets config. Optional: the defaults are the schema/ and
# config/markets/<network>.json that ship with the shared package.
# GH_SCHEMA_DIR=/path/to/schema
# GH_MARKETS_CONFIG=/path/to/markets.json

# --- Aggregator ---------------------------------------------------------------
# Balance changes from which an account is heavy: the account_rollups job keeps day rollups of these accounts, so that a read of
# years of their history (analytics, reports) does not read the millions of rows behind them. A whole number, plain digits.
# 0 turns the job off: the rollups that exist are still used by the API, and simply stop growing. Default 1000000.
# GH_ACCOUNT_ROLLUP_MIN_ROWS=1000000

# --- Validators ---------------------------------------------------------------
# Settings of the `validators` worker: validator lists (UNLs), domain verification and the amendment metadata.
# Comma separated `url=publicKey` pairs, the publishers of the validator lists (https:// URLs; the key is 66 hex digits
# starting ED, 02 or 03; no URL or key twice; the id `local` is taken). Unset, or the word `default`: the publishers of
# GH_NETWORK. Set but EMPTY: no publishers. Leave the line commented to get the default. The default of xahau:
#   https://vl.xahau.org=EDA46E9C39B1389894E690E58914DC1029602870370A0993E5B87C4A24EAF4A8E8
# The default of xrpl-testnet:
#   https://vl.altnet.rippletest.net=ED264807102805220DA0F312E71FC2C69E1552C9C5790F6C25E3729DEB573D5860
# (xahau-testnet has no publisher.) The default of xrpl, on the next line:
# GH_UNL_PUBLISHERS=https://vl.ripple.com=ED2677ABFFD1B33AC6FBC3062B71F1E8397C1505E1C42C64D11AD1B28FF73F4734,https://unl.xrplf.org=ED42AEC58B701EEBB77356FFFEC26F83C1F0407263530F068C7C73D392C7E06FD1
# A validator list fixed here, like the [validators] section of a node: comma separated validator public keys (n...), none
# twice. It counts as one more list, beside the publishers'. Unset, or the word `default`: the list of GH_NETWORK, which only
# xahau-testnet has (it has no publisher: its nodes trust these four keys). Set but EMPTY: no fixed list. The default of
# xahau-testnet, on the next line:
# GH_UNL_VALIDATORS=nHBoJCE3wPgkTcrNPMHyTJFQ2t77EyCAqcBRspFCpL6JhwCm94VZ,nHUVv4g47bFMySAZFUKVaXUYEmfiUExSoY4FzwXULNwJRzju4XnQ,nHBvr8avSFTz4TFxZvvi4rEJZZtyqE3J6KAAcVWVtifsE7edPM7q,nHUH3Z8TRU57zetHbEPr1ynyrJhxQCwrJvNjr4j1SMjYADyW1WWe
# Lists that must name a validator for it to be trusted: 0 = rippled's rule (1 below three lists, else half + 1), at most the
# number of lists (the publishers, plus one when GH_UNL_VALIDATORS is not empty).
GH_UNL_THRESHOLD=0
# Refresh interval of a list that gives no refresh_interval, in ms.
GH_UNL_REFRESH_MS=300000
# Check the domains that validators claim (an HTTPS fetch of the domain's TOML file). false skips the checks, for a host without
# outbound HTTPS: domains then show `pending`.
GH_DOMAIN_VERIFICATION=true
# How long a definite domain result stands before it is checked again, in ms (6 h).
GH_DOMAIN_RECHECK_MS=21600000
# Overall timeout of one TOML fetch, redirects included, in ms.
GH_DOMAIN_FETCH_TIMEOUT_MS=10000
# File of the amendment metadata (names, descriptions, specifications). Optional: the default is the config/amendments/<family>.json
# that ships with the shared package (xrpl.json for xrpl and xrpl-testnet, xahau.json for xahau and xahau-testnet). The API reads the
# same variable and should be given the same file.
# GH_AMENDMENTS_CONFIG=/path/to/amendments.json

# --- HTTP --------------------------------------------------------------------
# Liveliness probe: GET /liveliness/healthz. Answers 503 when ClickHouse does not answer, when ingest halted, or when
# the ingest lag stays above GH_MAX_LAG_HEALTHY ledgers for more than 60 s.
GH_HTTP_API_PORT=3002
GH_MAX_LAG_HEALTHY=10
# Prometheus metrics: GET /metricz on a second port.
GH_METRICZ_PORT=3000

# --- ClickHouse --------------------------------------------------------------
GH_CLICKHOUSE_URL=http://localhost:8123
GH_CLICKHOUSE_USER=default
GH_CLICKHOUSE_PASSWORD=
# Default: the database of the network (xrpl / xahau / xrpl_testnet / xahau_testnet).
# GH_CLICKHOUSE_DATABASE=xrpl
GH_CLICKHOUSE_REQUEST_TIMEOUT=60000
GH_CLICKHOUSE_MAX_CONNECTIONS=20
# Per-query safety caps (defense-in-depth). 0 = unlimited / server default.
GH_CLICKHOUSE_MAX_EXECUTION_TIME=30
GH_CLICKHOUSE_MAX_QUERY_MEMORY=0
