# Copy to apps/syncer/.env to run the syncer from source (`pnpm start:syncer`). In the docker stacks the same variables
# come from the compose files (docker-compose.yaml, docker-compose.prod.yaml + deploy/.env.prod.example).

# --- Configuration loading ---------------------------------------------------
# The toolbox config loader reads `.env` (or `.env.$NODE_ENV` when NODE_ENV is set) from the working directory and
# refuses to start when that file is missing. Where the variables come from the environment (containers run with
# NODE_ENV=production), set GH_ENV to any value to skip the file:
# GH_ENV=container

# --- Network -----------------------------------------------------------------
# One syncer per network. Selects the native currency (XRP / XAH), the CTID network id (0 / 21337), the markets
# config and the default ClickHouse database (GH_CLICKHOUSE_DATABASE below overrides it). Boot fails when the node's
# network_id does not match.
GH_NETWORK=xrpl

# Comma separated rippled / xahaud websocket URLs, tried in order with failover.
# Default when unset or empty: the public endpoints of GH_NETWORK (xrpl: wss://s2.ripple.com,wss://xrplcluster.com, xahau: wss://xahau.network).
# A node that answers "rate limit ... retry in ~<N>ms" (or slowDown / tooBusy) is left alone for that long, and the next
# endpoint of the list is used meanwhile.
# A full-history syncer should point at its own node, or at Ripple's full history server:
#   xrpl:  wss://s2.ripple.com (Ripple full history), wss://xrplcluster.com, or ws://your-own-rippled:6006
#   xahau: wss://xahau.network
GH_NODE_ENDPOINTS=wss://s2.ripple.com

# Nodes the validations collector subscribes to (one connection each). Default: GH_NODE_ENDPOINTS.
# GH_VALIDATION_ENDPOINTS=wss://s1.ripple.com,wss://s2.ripple.com

# --- Workers -----------------------------------------------------------------
# Comma separated subset of ingest,validations,fee_stats,aggregator. An empty value runs none of them (the process
# then only serves the probe and the metrics). Run exactly one syncer per network and database.
GH_WORKERS=ingest,validations,fee_stats,aggregator

# --- Ingest ------------------------------------------------------------------
# First ledger of a database that has none yet. Default: the validated head at boot. Ignored once ledgers exist
# (the syncer continues after the committed checkpoint).
# GH_SYNC_START_LEDGER=

# Timeout of one expanded `ledger` request, in ms.
GH_LEDGER_FETCH_TIMEOUT_MS=120000

# Catch-up: ledgers fetched in parallel, and when a batch is written to ClickHouse - at this many ledgers, this many
# transactions or this many ms, whichever comes first. 4 stays under the rate limits of the public nodes; raise it with
# your own node.
GH_CATCHUP_CONCURRENCY=4
GH_CATCHUP_FLUSH_LEDGERS=300
GH_CATCHUP_FLUSH_TXS=100000
GH_CATCHUP_FLUSH_MS=5000

# Apply the ClickHouse schema before the workers start (all DDL is idempotent, applied files are checksummed).
# Leave false where a one-shot migrate job owns the schema (the compose files: migrate-xrpl / migrate-xahau). Running from
# source, either set true or run `pnpm ch:migrate` (with GH_NETWORK set) once.
GH_RUN_MIGRATIONS_ON_BOOT=false

# Directory of the *.sql migrations and file of the aggregator's markets config. Optional: the defaults are the schema/ and
# config/markets/<network>.json that ship with the shared package.
# GH_SCHEMA_DIR=/path/to/schema
# GH_MARKETS_CONFIG=/path/to/markets.json

# --- HTTP --------------------------------------------------------------------
# Liveliness probe: GET /liveliness/healthz. Answers 503 when ClickHouse does not answer, when ingest halted, or when
# the ingest lag stays above GH_MAX_LAG_HEALTHY ledgers for more than 60 s.
GH_HTTP_API_PORT=3002
GH_MAX_LAG_HEALTHY=10
# Prometheus metrics: GET /metricz on a second port.
GH_METRICZ_PORT=3000

# --- ClickHouse --------------------------------------------------------------
GH_CLICKHOUSE_URL=http://localhost:8123
GH_CLICKHOUSE_USER=default
GH_CLICKHOUSE_PASSWORD=
# Default: the network name (xrpl / xahau).
# GH_CLICKHOUSE_DATABASE=xrpl
GH_CLICKHOUSE_REQUEST_TIMEOUT=60000
GH_CLICKHOUSE_MAX_CONNECTIONS=20
# Per-query safety caps (defense-in-depth). 0 = unlimited / server default.
GH_CLICKHOUSE_MAX_EXECUTION_TIME=30
GH_CLICKHOUSE_MAX_QUERY_MEMORY=0
