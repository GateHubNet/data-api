GH_SERVICE_NAME=data-syncer
GH_SERVICE_VERSION=0.0.1
GH_SERVICE_DESCRIPTION="GateHub XRPL syncer"

GH_LOGGER_FORMAT=pretty
GH_LOGGER_LEVEL=debug

# HTTP port for liveliness probe (Prometheus metrics are served on :3000/metricz)
GH_HTTP_API_PORT=3002

# --- XRPL connection ---------------------------------------------------------
# Mainnet full-history node recommended for a 2-year backfill. Examples:
#   wss://xrplcluster.com            (public full history cluster)
#   wss://s2.ripple.com              (Ripple full-history)
#   ws://your-own-rippled:6006       (your own node — see docs/backfill.md)
GH_XRPL_NODE_ENDPOINT=wss://xrplcluster.com
GH_XRPL_NETWORK_ID=0

# --- ClickHouse --------------------------------------------------------------
GH_CLICKHOUSE_URL=http://localhost:8123
GH_CLICKHOUSE_USER=default
GH_CLICKHOUSE_PASSWORD=
GH_CLICKHOUSE_DATABASE=xrpl
GH_CLICKHOUSE_REQUEST_TIMEOUT=60000
GH_CLICKHOUSE_MAX_CONNECTIONS=20

# --- Sync behaviour ----------------------------------------------------------
# Run the schema migration on boot (safe; all DDL is IF NOT EXISTS).
GH_RUN_MIGRATIONS_ON_BOOT=true

# Backfill historical ledgers between START and END (inclusive).
GH_BACKFILL_ENABLED=true
GH_BACKFILL_START_LEDGER=
GH_BACKFILL_END_LEDGER=
# Concurrent ledger fetchers. Raise with your own node; public clusters need fewer.
GH_BACKFILL_WORKERS=12
# Buffer this many ledgers before one batched INSERT per table (fewer, bigger writes
# = far less ClickHouse load and no "too many parts"). 500–2000 is a good range.
GH_BACKFILL_BATCH_LEDGERS=500

# Horizontal scaling: run N syncer instances, each owning a contiguous slice of the
# range. Instance i sets SHARD_INDEX=i, SHARD_TOTAL=N (point each at its own node).
GH_BACKFILL_SHARD_INDEX=0
GH_BACKFILL_SHARD_TOTAL=1

# Subscribe to live ledgers as they close (run alongside or instead of backfill).
GH_SUBSCRIBE_LIVE=true

# Throttle (ms) between ledger fetches per worker, to respect node rate limits.
# Set to 0 when pointing at your OWN full-history node (no rate limit).
GH_FETCH_THROTTLE_MS=100
