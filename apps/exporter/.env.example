# Copy to apps/exporter/.env to run the exporter from source (`pnpm start:exporter`). In the docker stacks the same
# variables come from the compose files (docker-compose.yaml, docker-compose.prod.yaml + deploy/.env.prod.example).

# --- Configuration loading ---------------------------------------------------
# The toolbox config loader reads `.env` (or `.env.$NODE_ENV` when NODE_ENV is set) from the working directory and
# refuses to start when that file is missing. Where the variables come from the environment (containers run with
# NODE_ENV=production), set GH_ENV to any value to skip the file:
# GH_ENV=container

# --- Network -----------------------------------------------------------------
# One exporter per network, and only one: it takes the queued export jobs of the network's database (export_jobs), and
# two exporters would take the same job. Selects the default ClickHouse database (GH_CLICKHOUSE_DATABASE overrides it)
# and the prefix of the files in the bucket (<network>/).
GH_NETWORK=xrpl

# --- The api the exporter walks ----------------------------------------------
# The base URL of this network's api: every export is made by walking the list's pages through it.
GH_API_URL=http://127.0.0.1:3001
# The exporter's own API key: one of the api's GH_API_KEYS, best given a large budget in the api's GH_RATE_LIMIT_KEYS.
# A secret. Empty sends no key (an api without keys, in development).
GH_EXPORTER_API_KEY=

# --- Storage -----------------------------------------------------------------
# The Google Cloud Storage bucket of the export files (the api's GH_EXPORT_BUCKET). Required. The files of a network are
# under <network>/; a lifecycle rule of the bucket deletes them after 7 days. The client uses the application default
# credentials, e.g. a service account key file:
GH_EXPORT_BUCKET=change-me-bucket
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Jobs --------------------------------------------------------------------
# The limit of each page the exporter asks for (1 to 1000; a list serves at most its own maximum).
GH_EXPORT_PAGE_SIZE=1000
# How often the exporter looks for a queued job while it has none (ms).
GH_EXPORT_POLL_MS=2000
# How long one page of a list may take (ms); a slower page fails the job.
GH_EXPORT_REQUEST_TIMEOUT_MS=60000
# The most rows an export holds, per format; a longer list fails the job. The same values as the api's.
GH_EXPORT_MAX_ROWS_CSV=1000000
GH_EXPORT_MAX_ROWS_PDF=10000

# --- Ports -------------------------------------------------------------------
# /liveliness/healthz
GH_HTTP_API_PORT=3005
# Prometheus metrics (GET /metricz), a second app on its own port.
GH_METRICZ_PORT=3000

# --- ClickHouse --------------------------------------------------------------
GH_CLICKHOUSE_URL=http://localhost:8123
GH_CLICKHOUSE_USER=default
GH_CLICKHOUSE_PASSWORD=
# Default: the network name (xrpl / xahau).
# GH_CLICKHOUSE_DATABASE=xrpl
