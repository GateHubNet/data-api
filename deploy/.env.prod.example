# Copy to deploy/.env.prod and fill in. In real deployments inject these from your
# secrets manager (Vault / AWS Secrets Manager / k8s secrets) - never commit secrets.
#
# docker-compose.prod.yaml reads this file twice: as the compose interpolation file (`--env-file deploy/.env.prod`) and
# as the env_file of the api and syncer containers, which therefore all see the GH_* variables below. Both networks share
# them. What differs per network is set in the compose file (GH_NETWORK, GH_CLICKHOUSE_DATABASE, GH_NODE_ENDPOINTS,
# GH_VALIDATION_ENDPOINTS, GH_SYNC_START_LEDGER, the ports) and is NOT read from this file: do not set those here.
# The containers get NODE_ENV=production and GH_ENV=container from the images, so no .env.production file is needed.

# --- ClickHouse: one server, one database per network (xrpl, xahau), created by the migrate jobs -------------------------
GH_CLICKHOUSE_USER=data_api
GH_CLICKHOUSE_PASSWORD=change-me-strong-password
# Per-query caps (api and syncer): max execution time in seconds and max memory in bytes. 0 = unlimited / server default.
GH_CLICKHOUSE_MAX_EXECUTION_TIME=30
GH_CLICKHOUSE_MAX_QUERY_MEMORY=0
# Client timeout (ms) and connection pool size; defaults 30000 and 10.
# GH_CLICKHOUSE_REQUEST_TIMEOUT=30000
# GH_CLICKHOUSE_MAX_CONNECTIONS=10

# --- Per network (compose interpolation only: docker-compose.prod.yaml turns these into GH_NODE_ENDPOINTS etc.) ---------
# Comma separated rippled / xahaud websocket URLs, tried in order. The syncer ingests from them and the api asks them for
# live state (balances, open orders). A full-history syncer should point at your own node or Ripple's full history server
# (XRPL: wss://s2.ripple.com).
XRPL_NODE_ENDPOINTS=wss://xrplcluster.com
XAHAU_NODE_ENDPOINTS=wss://xahau.network
# Nodes the validations collector subscribes to; empty = the node endpoints above.
XRPL_VALIDATION_ENDPOINTS=wss://s1.ripple.com,wss://s2.ripple.com
XAHAU_VALIDATION_ENDPOINTS=
# First ledger of a database that has none yet; empty = the validated head at the first boot. Ignored once ledgers exist.
XRPL_SYNC_START_LEDGER=
XAHAU_SYNC_START_LEDGER=
# Image tag of gatehub/data-syncer and gatehub/data-api (default: latest).
# IMAGE_TAG=latest

# --- API ----------------------------------------------------------------------------------------------------------------
# Comma separated API keys, sent as `X-API-Key` or `Authorization: Bearer`. /v2/* needs one; the API refuses to start
# in production without keys.
GH_API_KEYS=change-me-key-1,change-me-key-2
# `*`, or comma separated allowed CORS origins. Empty = no CORS headers.
GH_CORS_ORIGINS=https://app.gatehub.net
# Per-client rate limit of /v2/*: requests per window (seconds), counted per client address and route.
GH_RATE_LIMIT=600
GH_RATE_LIMIT_WINDOW=60
# TLS is terminated by the GateHub reverse proxy in front of nginx; the API speaks plain HTTP and trusts the
# X-Forwarded-For of that many proxy hops for client identification.
GH_TRUST_PROXY_HOPS=1
# TTL (ms) of cached live-node responses; 0 disables. Serialized transactions kept in memory by hash; 0 disables.
GH_LIVE_CACHE_TTL_MS=10000
GH_TX_CACHE_SIZE=20000
# Cache-Control of successful /v2/* responses; empty sends none.
GH_CACHE_CONTROL="public, max-age=60"

# --- Syncer -------------------------------------------------------------------------------------------------------------
# Comma separated subset of ingest,validations,fee_stats,aggregator. Run exactly one syncer per network and database.
GH_WORKERS=ingest,validations,fee_stats,aggregator
# Catch-up: ledgers fetched in parallel, and when a batch is written to ClickHouse (ledgers, transactions or ms, whichever
# comes first). Raise the concurrency with your own node; public clusters need less.
GH_CATCHUP_CONCURRENCY=8
GH_CATCHUP_FLUSH_LEDGERS=300
GH_CATCHUP_FLUSH_TXS=100000
GH_CATCHUP_FLUSH_MS=5000
# Timeout (ms) of one expanded `ledger` request.
GH_LEDGER_FETCH_TIMEOUT_MS=120000
# The liveliness probe answers 503 when the ingest lag stays above this many ledgers for more than 60 s.
GH_MAX_LAG_HEALTHY=10
